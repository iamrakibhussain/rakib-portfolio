# ==========================================
# Rakib Hussain Portfolio - Environment Variables
# ==========================================
# Copy this file to .env or .env.local and fill in the values

# ------------------------------------------
# 1. Application URL (SEO, Sitemap & Metadata)
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# 2. Email Delivery (Resend API)
# Get your API key from: https://resend.com/api-keys
# ------------------------------------------
RESEND_API_KEY="re_your_resend_api_key_here"

# The inbox where contact inquiries will be delivered
CONTACT_EMAIL="alrokib44@gmail.com"

# ------------------------------------------
# 3. Security & Cryptographic Shield
# Used to sign HMAC anti-bot and anti-tamper tokens
# Generate any long random string for production
# ------------------------------------------
SECURITY_TOKEN_SECRET="rakib_portfolio_secure_shield_key_2026"
